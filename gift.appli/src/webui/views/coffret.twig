{% extends "index.twig" %}

{% block content %}
    <h1>Les cofffrets</h1>
    
    <ul>
        {% for t in theme %}
            <li>
                <h2>{{ t.libelle }}</h2>
                <ul>
                    {% for c in coffrets %}
                        {% if c.theme_id == t.id %}
                            <li>
                                <a href= "{{ url_for('coffretDetaille', {}, {'id': c.id}) }}"> {{ c.libelle }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>
{% endblock %}