{% extends "index.twig" %}

{% block content %}
    <h1>La Prestation {{ prestation.libelle }}</h1>

    <p>{{ prestation.description }}</p>
    <p>{{ prestation.tarif }}€</p>
        <br>

    <form action="{{ url_for('addpresta', {'id': prestation.id}) }}" method="POST">
        <button type="submit">Ajouter à la box</button>
    </form>
    
    <br>
    <br>
    <a href="{{ url_for('presta2', {}, {'cat_id': prestation.cat_id}) }}">Retour</a>
    <br>
{% endblock %}